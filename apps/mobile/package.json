{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "APP_VARIANT=development npx expo start -c",
    "android": "APP_VARIANT=development npx expo run:android",
    "ios": "yarn fix-xcode-env && APP_VARIANT=development npx expo run:ios",
    "eject": "npx expo eject",
    "fix-xcode-env": "node scripts/fix-xcode-env.mjs",
    "prebuild": "yarn expo prebuild",
    "build:prod": "npx eas-cli build --platform ios --profile production --auto-submit",
    "update:prod": "npx eas-cli update --channel production --environment production --platform ios",
    "update:preview": "npx eas-cli update --channel preview --environment preview --platform ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@lexical/react": "^0.33.1",
    "@my/ui": "0.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.3.25",
    "@sentry/react-native": "8.18.0",
    "@tamagui/native": "3.1.10",
    "app": "0.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "burnt": "^0.12.2",
    "expo": "^55.0.0",
    "expo-application": "~55.0.19",
    "expo-auth-session": "~55.0.19",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "lexical": "^0.33.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-quick-crypto": "^1.0.16",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "reanimated-color-picker": "^4.2.0",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@types/react": "~19.2.0",
    "metro-minify-terser": "^0.83.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  }
}
