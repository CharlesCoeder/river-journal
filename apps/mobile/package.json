{
  "name": "mobile-app",
  "version": "1.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "APP_VARIANT=development npx expo start -c",
    "android": "APP_VARIANT=development npx expo run:android",
    "ios": "yarn fix-xcode-env && APP_VARIANT=development npx expo run:ios",
    "eject": "npx expo eject",
    "fix-xcode-env": "node scripts/fix-xcode-env.mjs",
    "prebuild": "yarn expo prebuild",
    "build:prod": "npx eas-cli build --platform ios --profile production --auto-submit",
    "update:prod": "npx eas-cli update --channel production --environment production --platform ios",
    "update:preview": "npx eas-cli update --channel preview --environment preview --platform ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@lexical/react": "^0.33.1",
    "@my/ui": "0.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@tamagui/native": "3.1.10",
    "app": "0.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "burnt": "^0.12.2",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "lexical": "^0.33.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "^4.2.0",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tamagui/metro-plugin": "3.1.10",
    "@types/react": "~19.3.0",
    "metro-minify-terser": "^0.87.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
